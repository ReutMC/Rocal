<Window x:Class="Rocal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rocal" Width="1120" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Tahoma"
        FlowDirection="{Binding Loc.FlowDirection}">
    <Grid>
        <!-- Main shell; disabled while the first-run tour is open so keyboard focus stays in the tour -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Onboarding.IsVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Margin="12" Padding="14" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                                <TextBlock Text="R" Foreground="White" FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Rocal" FontSize="22" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0" />
                        </Grid>
                        <TextBlock Text="{Binding Loc[App_Tagline]}" Style="{StaticResource Label}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 AutomationProperties.Name="Rocal navigation">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Page content: the matching DataTemplate in Views/PageTemplates.xaml is picked by view-model type -->
            <ContentControl Grid.Column="1" Margin="12,24,28,24" Content="{Binding SelectedPage}" IsTabStop="False" />
        </Grid>

        <!-- First-run tour overlay -->
        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Onboarding.IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{StaticResource ScrimBrush}" />

            <Border Style="{StaticResource Card}" Width="520" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding Onboarding}"
                    AutomationProperties.Name="{Binding Loc[Onboarding_Welcome]}">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Onboarding_Welcome]}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" />

                    <Border Width="72" Height="72" CornerRadius="36" Margin="0,18,0,0" HorizontalAlignment="Left"
                            Background="{StaticResource PrimarySoftBrush}">
                        <TextBlock Text="{Binding StepGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="30" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding StepTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StepBody}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" LineHeight="22" />
                    <TextBlock Text="{Binding Loc[Onboarding_Note]}" Style="{StaticResource Label}" Margin="0,14,0,0"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Dots}" Margin="0,22,0,0" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8" Margin="3,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource LineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,22,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                                Command="{Binding SkipCommand}" Content="{Binding Loc[Onboarding_Skip]}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" IsDefault="True"
                                Command="{Binding NextCommand}" Content="{Binding NextLabel}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="8,0"
                                IsEnabled="{Binding CanGoBack}"
                                Command="{Binding BackCommand}" Content="{Binding Loc[Onboarding_Back]}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
