<UserControl x:Class="Rocal.App.Views.Controls.SectionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Rocal.App.Views.Controls"
             Focusable="False">
    <Border Style="{StaticResource Card}" Padding="18" MinHeight="220">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <ctl:EmptyState Glyph="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Title="{Binding EmptyTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Message="{Binding EmptyMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DockPanel>
    </Border>
</UserControl>
