<UserControl x:Class="Rocal.App.Views.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimarySoftBrush}"
                HorizontalAlignment="Center">
            <TextBlock Text="{Binding Glyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,12,0,2" />
        <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource Label}" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
