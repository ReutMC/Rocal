<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Rocal.App.ViewModels">

    <!-- Home -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}" Content="{Binding Loc[Home_Refresh]}"
                            VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                </DockPanel>

                <UniformGrid Columns="3" Margin="-6,18,-6,0">
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Loc[Home_ComputerName]}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ComputerName}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Loc[Home_LocalIp]}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LocalAddress}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Loc[Home_NetworkStatus]}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="10" Height="10" Margin="2,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetworkAvailable}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"
                                           Text="{Binding NetworkStatusText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Settings -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Loc[Settings_Language]}" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="{Binding Loc[Settings_LanguageHint]}" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Name" Padding="10,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Features that are not built yet (no fake controls) -->
    <DataTemplate DataType="{x:Type vm:ComingSoonPageViewModel}">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource PrimarySoftBrush}">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="34" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" FontSize="14"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
