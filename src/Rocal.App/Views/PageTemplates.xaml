<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Rocal.App.ViewModels"
                    xmlns:ctl="clr-namespace:Rocal.App.Views.Controls">

    <!-- Home -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,24">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}" Content="{Binding Loc[Home_Refresh]}"
                            ToolTip="{Binding Loc[Home_RefreshTip]}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource Label}" FontSize="14" Margin="0,4,0,0"
                                   Text="{Binding Loc[Home_Subtitle]}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <!-- Network status -->
                <WrapPanel Margin="-6,18,-6,0">
                    <Border Style="{StaticResource Card}" Margin="6" Width="220">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Loc[Home_ComputerName]}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ComputerName}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6" Width="220">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Loc[Home_LocalIp]}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding LocalAddress}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6" Width="220">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Loc[Home_NetworkStatus]}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="10" Height="10" Margin="2,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetworkAvailable}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"
                                           Text="{Binding NetworkStatusText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Quick actions: each one navigates to its page -->
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,22,0,8" Text="{Binding Loc[Home_QuickActions]}" />
                <WrapPanel Margin="-4,0">
                    <Button Style="{StaticResource SecondaryButton}" Margin="4" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:PageId.Devices}" Content="{Binding Loc[QA_FindDevices]}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="4" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:PageId.Files}" Content="{Binding Loc[QA_SendFiles]}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="4" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:PageId.Messages}" Content="{Binding Loc[QA_Messages]}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="4" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:PageId.Remote}" Content="{Binding Loc[QA_Remote]}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="4" Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:PageId.Games}" Content="{Binding Loc[QA_Games]}" />
                </WrapPanel>

                <!-- Activity sections: empty states until the matching features exist -->
                <WrapPanel Margin="-6,14,-6,0">
                    <ctl:SectionCard Margin="6" Width="330" Glyph="&#xE772;"
                                     Title="{Binding Loc[Home_ConnectedDevices]}"
                                     EmptyTitle="{Binding Loc[State_Empty]}"
                                     EmptyMessage="{Binding Loc[Home_Empty_Connected]}" />
                    <ctl:SectionCard Margin="6" Width="330" Glyph="&#xE81C;"
                                     Title="{Binding Loc[Home_RecentDevices]}"
                                     EmptyTitle="{Binding Loc[State_Empty]}"
                                     EmptyMessage="{Binding Loc[Home_Empty_Devices]}" />
                    <ctl:SectionCard Margin="6" Width="330" Glyph="&#xE8A5;"
                                     Title="{Binding Loc[Home_RecentTransfers]}"
                                     EmptyTitle="{Binding Loc[State_Empty]}"
                                     EmptyMessage="{Binding Loc[Home_Empty_Transfers]}" />
                    <ctl:SectionCard Margin="6" Width="330" Glyph="&#xE8BD;"
                                     Title="{Binding Loc[Home_RecentConversations]}"
                                     EmptyTitle="{Binding Loc[State_Empty]}"
                                     EmptyMessage="{Binding Loc[Home_Empty_Conversations]}" />
                    <ctl:SectionCard Margin="6" Width="330" Glyph="&#xE7FC;"
                                     Title="{Binding Loc[Home_RecentGames]}"
                                     EmptyTitle="{Binding Loc[State_Empty]}"
                                     EmptyMessage="{Binding Loc[Home_Empty_Games]}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Settings -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,24">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />

                <Border Style="{StaticResource Card}" Margin="0,18,0,0" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Loc[Settings_Language]}" />
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,12"
                                   Text="{Binding Loc[Settings_LanguageHint]}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="Name" Padding="10,8"
                                  AutomationProperties.Name="{Binding Loc[Settings_Language]}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Loc[Settings_Tour]}" />
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,12"
                                   Text="{Binding Loc[Settings_TourHint]}" />
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Command="{Binding ShowTourCommand}" Content="{Binding Loc[Settings_TourButton]}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Features that are not built yet (no fake controls) -->
    <DataTemplate DataType="{x:Type vm:ComingSoonPageViewModel}">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource PrimarySoftBrush}">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="34" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" FontSize="14"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
